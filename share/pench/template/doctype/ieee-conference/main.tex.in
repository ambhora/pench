% Repeat \IEEEauthorblockN / \IEEEauthorblockA groups separated by \and
% for multiple authors. Change the affiliation as necessary.
\author{\IEEEauthorblockN{@@author@@}
\IEEEauthorblockA{\textit{@@affiliation@@}\\
@@email@@}}

\maketitle

\begin{abstract}
@@abstract@@
\end{abstract}

\begin{IEEEkeywords}
@@keywords@@
\end{IEEEkeywords}

\section{Introduction}
State the problem and contributions. Cite prior work using numerical
IEEE references, for example~\cite{lamport1994latex}.

\section{Methodology}
Explain the experimental setup and provide enough detail to reproduce it.
For example, write equations using standard LaTeX:
\begin{equation}
    E = mc^{2}.
    \label{eq:example}
\end{equation}

% Put figure captions below figures and table captions above tables.
