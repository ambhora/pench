% --------------------------------------------------------------------------------------------------
% Date Formatting
% --------------------------------------------------------------------------------------------------
\RequirePackage[english]{datetime2}
\RequirePackage{expl3}

% -- Check if the date is in ISO 8601 format, if not throw an error
% -- If the date is in ISO format, convert it to human-readable format
% -- and store it in \@date
\AtEndPreamble{%
  \RequirePackage{expl3}
  \RequirePackage{etoolbox}
  \ExplSyntaxOn
  \makeatletter
  \edef\rawdate{\@date} % Expand \@date to a regular string
  \makeatother

  \msg_new:nnn{ambhoratools}{invalid-format}{
  Use~of~penchcommon~package~requires~date~to~be~in~ISO~format,~
  e.g.,~`\date{2025-06-08}`.~You~instead~provided~`#1`~when~using~the~\date~command.
  }

  \msg_new:nnn{ambhoratools}{logmessage}{
  The~date~is~valid:~#1.
  }

  \regex_match:nVTF { ^\d{4}-\d{2}-\d{2}$ } { \rawdate }
  {\msg_info:nnV {ambhoratools} {logmessage}{\rawdate}}
  {\msg_error:nnV {ambhoratools} {invalid-format}{\rawdate}}
  \ExplSyntaxOff

  % -- Convert ISO 8601 date to DTM format
  \def\extractyearfromiso#1-#2-#3\relax{#1}
  \def\extractmonthfromiso#1-#2-#3\relax{#2}
  \def\extractdayfromiso#1-#2-#3\relax{#3}
  \edef\yearpart{\expandafter\extractyearfromiso\@date\relax}%
  \edef\monthpart{\expandafter\extractmonthfromiso\@date\relax}%
  \edef\daypart{\expandafter\extractdayfromiso\@date\relax}%
  \newcommand{\humandate}{%
  \DTMdisplaydate{\yearpart}{\monthpart}{\daypart}{-1}}%
  \gdef\@isodate{\@date}
  \def\@date{\humandate}
}

