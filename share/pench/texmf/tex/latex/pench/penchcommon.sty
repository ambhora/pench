% -- The penchcommon package provides definitions and utilities that are
% -- common across different document types in the Ambhora ecosystem.
\ProvidesPackage{penchcommon}
\ProvidesExplPackage
  {penchcommon} % package name
  {2025/06/09}   % date
  {0.1}          % version
  {Pench Common Package} % description



% -- Use the penchdesign package for consistent design
\RequirePackage{penchdesign}

% -- Language Support
\RequirePackage{polyglossia}
\setmainlanguage{english}

% -- Smart Quotes
\RequirePackage{csquotes}

% -- Package to set space between lines
\RequirePackage{setspace}

% -- Package for inserting CC license information
\RequirePackage{ccicons}

% -- Add correct metadata to the document
\PassOptionsToPackage{hypertexnames=true,plainpages=false,pdfpagelabels}{hyperref}
\RequirePackage{hyperref}
\RequirePackage{hyperxmp}
\hypersetup{
  keeppdfinfo,
  pdftitle={\@title},
  pdfauthor={\@author},
  pdfsubject={\@subject}
}

% -- Bibliography and Citation Support
\PassOptionsToPackage
{sortcites=true,sorting=nyt,bibstyle=alphabetic,citestyle=alphabetic,backend=biber}
{biblatex}
\RequirePackage{biblatex}




% --------------------------------------------------------------------------------------------------
%  Configure Hyperlink Support
% --------------------------------------------------------------------------------------------------
\PassOptionsToPackage{capitalize,nameinlink}{cleveref}
\RequirePackage{cleveref}

\hypersetup{
  colorlinks=true,
  urlcolor=ambhoraBlue,
  linkcolor=ambhoraBlue,
  citecolor=ambhoraGreen
}
